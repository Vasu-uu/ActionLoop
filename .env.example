# Copy to .env and edit. Never commit .env.
# ---- LLM provider: anthropic | openai | ollama | demo  (empty = auto: key found -> that provider, else demo)
LLM_PROVIDER=demo

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI or any OpenAI-compatible server (LM Studio, vLLM, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama (fully local, no data leaves your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ---- Whisper (faster-whisper, local): tiny | base | small | medium
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# ---- Server
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MAX_UPLOAD_MB=100
CHUNK_TOKEN_THRESHOLD=6000
# DATABASE_URL=sqlite:///./data/actionloop.db
